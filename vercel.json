{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/vertical",
      "destination": "/main-stage/vertical.html"
    },
    {
      "source": "/vertical.html",
      "destination": "/main-stage/vertical.html"
    },
    {
      "source": "/ParishRobertson/triptico",
      "destination": "/ParishRobertson/triptico.html"
    },
    {
      "source": "/triptico",
      "destination": "/ParishRobertson/triptico.html"
    },
    {
      "source": "/triptico.html",
      "destination": "/ParishRobertson/triptico.html"
    }
  ],
  "headers": [
    {
      "source": "/ParishRobertson(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/2027(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/2027b(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/main-stage(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/vertical(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
